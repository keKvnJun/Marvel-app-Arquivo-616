<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Marvel.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="TextAppearance.Marvel.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="TextAppearance.Marvel.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Marvel.TitleSmall" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title_small</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Marvel.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.Marvel.BodySecondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.Marvel.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Widget.Marvel.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="backgroundTint">@color/marvel_red</item>
        <item name="cornerRadius">@dimen/radius_small</item>
        <item name="iconTint">@color/text_on_accent</item>
    </style>

    <style name="Widget.Marvel.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">@dimen/radius_small</item>
        <item name="strokeColor">@color/outline_color</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
    </style>

    <style name="Widget.Marvel.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="iconTint">@color/text_primary</item>
    </style>

    <style name="Widget.Marvel.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_primary</item>
        <item name="cardCornerRadius">@dimen/radius_medium</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/outline_subtle</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
    </style>

    <style name="Widget.Marvel.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_primary</item>
        <item name="cardCornerRadius">@dimen/radius_medium</item>
        <item name="strokeColor">@color/outline_color</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
    </style>

    <style name="Widget.Marvel.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:minHeight">40dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipBackgroundColor">@color/surface_secondary</item>
        <item name="chipStrokeColor">@color/outline_subtle</item>
        <item name="chipStrokeWidth">@dimen/stroke_thin</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Marvel.Pill</item>
    </style>

    <style name="Widget.Marvel.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">@dimen/bottom_navigation_height</item>
        <item name="backgroundTint">@color/surface_primary</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Marvel.BottomNavigation.Indicator</item>
        <item name="itemIconSize">26dp</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Marvel.BottomNavigation.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/comic_ink_08</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Marvel.Pill</item>
    </style>

    <style name="Widget.Marvel.NavButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="Widget.Marvel.NavIcon">
        <item name="android:layout_width">27dp</item>
        <item name="android:layout_height">27dp</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="Widget.Marvel.NavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.Marvel.Pill" parent="ShapeAppearance.Material3.Corner.Full" />
</resources>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/splash_comic_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/comic_collage_splash" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_splash_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_xl">

        <ImageView
            android:id="@+id/splash_shield_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/shield_logo_description"
            android:src="@drawable/ic_shield"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/splash_title"
            style="@style/TextAppearance.Marvel.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_red_label"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/app_name"
            android:textColor="@color/white" />

        <TextView
            style="@style/TextAppearance.Marvel.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/home_status"
            android:textColor="@color/white" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/splash_progress"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:indeterminate="true"
            app:indicatorColor="@color/marvel_red"
            app:trackColor="#55FFFFFF"
            app:trackThickness="4dp" />
    </LinearLayout>

    <TextView
        style="@style/TextAppearance.Marvel.BodySecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/space_xl"
        android:text="@string/loading_files"
        android:textColor="@color/white" />

</FrameLayout>

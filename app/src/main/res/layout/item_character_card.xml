<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/card_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_sm"
    android:layout_marginBottom="@dimen/space_xs"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_primary"
    app:cardCornerRadius="@dimen/radius_medium"
    app:cardElevation="2dp"
    app:strokeColor="@color/outline_subtle"
    app:strokeWidth="@dimen/stroke_thin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_image_height">

            <ImageView
                android:id="@+id/character_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/surface_secondary"
                android:contentDescription="@string/loading_image"
                android:scaleType="centerCrop"
                tools:src="@drawable/comic_collage_muted" />

            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_image_scrim" />

            <TextView
                android:id="@+id/character_category"
                style="@style/TextAppearance.Marvel.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:layout_margin="@dimen/space_xs"
                android:background="@drawable/bg_red_label"
                android:text="@string/character_category"
                android:textColor="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/favorite_button"
                style="@style/Widget.Marvel.Button.Icon"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_gravity="end|top"
                android:contentDescription="@string/favorite_add"
                app:backgroundTint="@color/surface_elevated"
                app:icon="@drawable/ic_favorite_outline"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_sm">

            <TextView
                android:id="@+id/character_name"
                style="@style/TextAppearance.Marvel.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="@string/character_name_sample" />

            <TextView
                android:id="@+id/character_identity"
                style="@style/TextAppearance.Marvel.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="@string/character_identity_sample" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bolt" />

                <TextView
                    android:id="@+id/power_count"
                    style="@style/TextAppearance.Marvel.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xxs"
                    android:layout_weight="1"
                    tools:text="8" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_comic" />

                <TextView
                    android:id="@+id/appearance_count"
                    style="@style/TextAppearance.Marvel.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xxs"
                    tools:text="512" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

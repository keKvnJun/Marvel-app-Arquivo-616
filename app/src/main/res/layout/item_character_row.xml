<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Marvel.Card.Outlined"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:layout_marginBottom="@dimen/space_xs"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_xs">

        <ImageView
            android:id="@+id/row_character_image"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@color/surface_secondary"
            android:contentDescription="@string/loading_image"
            android:scaleType="centerCrop"
            tools:src="@drawable/comic_collage_muted" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row_character_name"
                style="@style/TextAppearance.Marvel.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="@string/character_name_sample" />

            <TextView
                android:id="@+id/row_character_identity"
                style="@style/TextAppearance.Marvel.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="@string/character_identity_sample" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/row_favorite_button"
            style="@style/Widget.Marvel.Button.Icon"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:contentDescription="@string/favorite_add"
            app:icon="@drawable/ic_favorite_outline"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

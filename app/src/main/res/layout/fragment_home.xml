<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/space_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Marvel.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_status"
                    android:textColor="@color/success_green" />

                <TextView
                    style="@style/TextAppearance.Marvel.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_greeting" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/theme_button"
                style="@style/Widget.Marvel.Button.Icon"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:contentDescription="@string/theme_toggle"
                app:icon="@drawable/ic_theme"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/spider_verse_feature"
            style="@style/Widget.Marvel.Card"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginTop="@dimen/space_sm"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/comic_collage_halftone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_image_scrim" />

                <View
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="@dimen/space_md"
                    android:background="@drawable/bg_portal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_md"
                    android:paddingTop="@dimen/space_md"
                    android:paddingEnd="132dp"
                    android:paddingBottom="@dimen/space_md">

                    <TextView
                        style="@style/TextAppearance.Marvel.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_red_label"
                        android:text="@string/spider_file"
                        android:textColor="@color/white" />

                    <TextView
                        style="@style/TextAppearance.Marvel.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/home_spider_title"
                        android:textColor="@color/white" />

                    <TextView
                        style="@style/TextAppearance.Marvel.BodySecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:maxLines="2"
                        android:text="@string/home_spider_subtitle"
                        android:textColor="@color/white" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding">

            <TextView
                style="@style/TextAppearance.Marvel.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_featured" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/view_all_featured_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:text="@string/action_view_all"
                android:textColor="@color/marvel_red" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/featured_characters_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            tools:itemCount="3"
            tools:listitem="@layout/item_character_card" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding">

            <TextView
                style="@style/TextAppearance.Marvel.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_recent" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shield" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recent_characters_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/screen_padding"
            tools:itemCount="2"
            tools:listitem="@layout/item_character_row" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

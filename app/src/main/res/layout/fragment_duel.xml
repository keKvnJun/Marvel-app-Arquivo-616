<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            style="@style/TextAppearance.Marvel.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/card_game_title" />

        <TextView
            style="@style/TextAppearance.Marvel.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/card_game_subtitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Marvel.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    style="@style/TextAppearance.Marvel.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pack_title" />

                <TextView
                    style="@style/TextAppearance.Marvel.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pack_subtitle" />

                <LinearLayout
                    android:id="@+id/pack_results"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/pack_result_one"
                        style="@style/TextAppearance.Marvel.Label"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_marginEnd="@dimen/space_xxs"
                        android:layout_weight="1"
                        android:background="@drawable/bg_duel_slot"
                        android:gravity="center"
                        android:padding="@dimen/space_xs"
                        tools:text="RARA&#10;Spider-Man" />

                    <TextView
                        android:id="@+id/pack_result_two"
                        style="@style/TextAppearance.Marvel.Label"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_marginHorizontal="@dimen/space_xxs"
                        android:layout_weight="1"
                        android:background="@drawable/bg_duel_slot"
                        android:gravity="center"
                        android:padding="@dimen/space_xs"
                        tools:text="ÉPICA&#10;Storm" />

                    <TextView
                        android:id="@+id/pack_result_three"
                        style="@style/TextAppearance.Marvel.Label"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_marginStart="@dimen/space_xxs"
                        android:layout_weight="1"
                        android:background="@drawable/bg_duel_slot"
                        android:gravity="center"
                        android:padding="@dimen/space_xs"
                        tools:text="LENDÁRIA&#10;Thor" />
                </LinearLayout>

                <TextView
                    android:id="@+id/pack_status_text"
                    style="@style/TextAppearance.Marvel.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/pack_ready" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/open_pack_button"
                    style="@style/Widget.Marvel.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/pack_open"
                    app:icon="@drawable/ic_cards" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/collection_summary_text"
            style="@style/TextAppearance.Marvel.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_red_label"
            android:textColor="@color/text_on_red_label"
            tools:text="COLEÇÃO 3 • DECK 3/3" />

        <TextView
            android:id="@+id/duel_round_text"
            style="@style/TextAppearance.Marvel.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_lg"
            tools:text="RODADA 1 DE 3" />

        <TextView
            android:id="@+id/duel_score_text"
            style="@style/TextAppearance.Marvel.TitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            tools:text="Você 0 × 0 Arquivo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal"
            android:weightSum="2">

            <include
                android:id="@+id/player_duel_card"
                layout="@layout/item_duel_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_xs"
                android:layout_weight="1" />

            <include
                android:id="@+id/opponent_duel_card"
                layout="@layout/item_duel_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cycle_card_button"
            style="@style/Widget.Marvel.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/deck_cycle"
            app:icon="@drawable/ic_cards" />

        <TextView
            style="@style/TextAppearance.Marvel.TitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/duel_choose_attribute" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/duel_attribute_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/attribute_powers_chip"
                style="@style/Widget.Marvel.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/duel_powers"
                app:chipIcon="@drawable/ic_bolt" />

            <com.google.android.material.chip.Chip
                android:id="@+id/attribute_experience_chip"
                style="@style/Widget.Marvel.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/duel_experience"
                app:chipIcon="@drawable/ic_calendar" />

            <com.google.android.material.chip.Chip
                android:id="@+id/attribute_appearances_chip"
                style="@style/Widget.Marvel.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/duel_appearances"
                app:chipIcon="@drawable/ic_comic" />

            <com.google.android.material.chip.Chip
                android:id="@+id/attribute_impact_chip"
                style="@style/Widget.Marvel.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/duel_impact"
                app:chipIcon="@drawable/ic_shield" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/start_duel_button"
            style="@style/Widget.Marvel.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/duel_start"
            app:icon="@drawable/ic_bolt" />

        <TextView
            style="@style/TextAppearance.Marvel.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_lg"
            android:gravity="center"
            android:text="@string/card_game_disclosure" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Marvel.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/duel_title" />

                <TextView
                    style="@style/TextAppearance.Marvel.BodySecondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/duel_subtitle" />
            </LinearLayout>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_cards"
                app:tint="@color/marvel_red" />
        </LinearLayout>

        <TextView
            android:id="@+id/duel_round_text"
            style="@style/TextAppearance.Marvel.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_red_label"
            android:textColor="@color/white"
            tools:text="RODADA 1 DE 3" />

        <TextView
            android:id="@+id/duel_score_text"
            style="@style/TextAppearance.Marvel.TitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_xs"
            tools:text="Você 0 × 0 Arquivo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="2">

            <include
                android:id="@+id/player_duel_card"
                layout="@layout/item_duel_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_xs"
                android:layout_weight="1" />

            <include
                android:id="@+id/opponent_duel_card"
                layout="@layout/item_duel_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.Marvel.TitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/duel_choose_attribute" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/duel_attribute_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/attribute_powers_chip"
                style="@style/Widget.Marvel.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/duel_powers"
                app:chipIcon="@drawable/ic_bolt"
                app:chipIconVisible="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/attribute_experience_chip"
                style="@style/Widget.Marvel.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/duel_experience"
                app:chipIcon="@drawable/ic_calendar"
                app:chipIconVisible="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/attribute_appearances_chip"
                style="@style/Widget.Marvel.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/duel_appearances"
                app:chipIcon="@drawable/ic_comic"
                app:chipIconVisible="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/attribute_impact_chip"
                style="@style/Widget.Marvel.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/duel_impact"
                app:chipIcon="@drawable/ic_shield"
                app:chipIconVisible="true" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/start_duel_button"
            style="@style/Widget.Marvel.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/duel_start"
            app:icon="@drawable/ic_bolt"
            app:iconTint="@color/white" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

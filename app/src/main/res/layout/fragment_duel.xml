<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:id="@+id/duel_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_sm"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Marvel.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_game_title" />

                <TextView
                    style="@style/TextAppearance.Marvel.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battle_best_of_three" />
            </LinearLayout>

            <TextView
                android:id="@+id/collection_summary_text"
                style="@style/TextAppearance.Marvel.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_red_label"
                android:textColor="@color/white"
                tools:text="COLEÇÃO 8 • DECK 3/3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pack_status_text"
                style="@style/TextAppearance.Marvel.BodySecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/pack_ready" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_pack_button"
                style="@style/Widget.Marvel.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="40dp"
                android:text="@string/pack_open_compact"
                app:icon="@drawable/ic_cards" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/battle_table"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_weight="1"
            android:background="@drawable/bg_battle_table"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_xs">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Marvel.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/battle_rival_zone" />

                <TextView
                    android:id="@+id/duel_round_text"
                    style="@style/TextAppearance.Marvel.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="RODADA 1 DE 3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/opponent_slot_one"
                    android:layout_width="36dp"
                    android:layout_height="42dp"
                    android:layout_marginHorizontal="@dimen/space_xs"
                    android:contentDescription="@string/battle_rival_hidden_card"
                    android:src="@drawable/bg_battle_card_back" />

                <ImageView
                    android:id="@+id/opponent_slot_two"
                    android:layout_width="36dp"
                    android:layout_height="42dp"
                    android:layout_marginHorizontal="@dimen/space_xs"
                    android:contentDescription="@string/battle_rival_hidden_card"
                    android:src="@drawable/bg_battle_card_back" />

                <ImageView
                    android:id="@+id/opponent_slot_three"
                    android:layout_width="36dp"
                    android:layout_height="42dp"
                    android:layout_marginHorizontal="@dimen/space_xs"
                    android:contentDescription="@string/battle_rival_hidden_card"
                    android:src="@drawable/bg_battle_card_back" />
            </LinearLayout>

            <include
                android:id="@+id/opponent_duel_card"
                layout="@layout/item_battle_active_card"
                android:layout_width="260dp"
                android:layout_height="96dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/space_xxs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/duel_score_text"
                    style="@style/TextAppearance.Marvel.TitleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_red_label"
                    android:textColor="@color/white"
                    tools:text="Você 1 × 0 Arquivo" />

                <TextView
                    android:id="@+id/duel_result_banner"
                    style="@style/TextAppearance.Marvel.BodySecondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_duel_slot"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:minHeight="44dp"
                    android:padding="@dimen/space_xs"
                    tools:text="Mesa pronta. Escolha sua carta." />
            </LinearLayout>

            <include
                android:id="@+id/player_duel_card"
                layout="@layout/item_battle_active_card"
                android:layout_width="260dp"
                android:layout_height="96dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:fillViewport="true"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/duel_attribute_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/attribute_powers_chip"
                        style="@style/Widget.Marvel.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/duel_powers"
                        app:chipIcon="@drawable/ic_bolt" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/attribute_experience_chip"
                        style="@style/Widget.Marvel.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duel_experience"
                        app:chipIcon="@drawable/ic_calendar" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/attribute_appearances_chip"
                        style="@style/Widget.Marvel.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duel_appearances"
                        app:chipIcon="@drawable/ic_comic" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/attribute_impact_chip"
                        style="@style/Widget.Marvel.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duel_impact"
                        app:chipIcon="@drawable/ic_shield" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/start_duel_button"
                style="@style/Widget.Marvel.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:text="@string/duel_start"
                app:icon="@drawable/ic_bolt" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Marvel.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/battle_hand_zone" />

                <TextView
                    style="@style/TextAppearance.Marvel.BodySecondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battle_hand_hint_compact" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:orientation="horizontal"
                android:weightSum="3">

                <include
                    android:id="@+id/hand_card_one"
                    layout="@layout/item_battle_hand_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xxs"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/hand_card_two"
                    layout="@layout/item_battle_hand_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_xxs"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/hand_card_three"
                    layout="@layout/item_battle_hand_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xxs"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.Marvel.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/card_game_disclosure_short" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/mission_result_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim_color"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Marvel.Card"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:elevation="18dp"
            app:cardCornerRadius="@dimen/radius_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    style="@style/TextAppearance.Marvel.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mission_result_label"
                    android:textColor="@color/marvel_red" />

                <ImageView
                    android:id="@+id/mission_result_image"
                    android:layout_width="140dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="@dimen/space_xs"
                    android:contentDescription="@string/card_art_description"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/comic_collage_halftone" />

                <TextView
                    android:id="@+id/mission_result_title"
                    style="@style/TextAppearance.Marvel.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center"
                    tools:text="Missão concluída" />

                <TextView
                    android:id="@+id/mission_result_score"
                    style="@style/TextAppearance.Marvel.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/marvel_red"
                    tools:text="2 × 1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mission_continue_button"
                    style="@style/Widget.Marvel.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/mission_result_continue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <com.example.marvel_app.ui.widget.PackOpeningView
        android:id="@+id/pack_opening_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/duel_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Marvel.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_game_title" />

                <TextView
                    style="@style/TextAppearance.Marvel.BodySecondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battle_best_of_three" />
            </LinearLayout>

            <TextView
                android:id="@+id/collection_summary_text"
                style="@style/TextAppearance.Marvel.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_red_label"
                android:textColor="@color/text_on_red_label"
                tools:text="DECK 3/3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_battle_table"
            android:orientation="vertical"
            android:padding="@dimen/space_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Marvel.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/battle_rival_zone" />

                <TextView
                    android:id="@+id/duel_round_text"
                    style="@style/TextAppearance.Marvel.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="RODADA 1 DE 3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/opponent_slot_one"
                    android:layout_width="48dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="@dimen/space_xs"
                    android:contentDescription="@string/battle_rival_hidden_card"
                    android:padding="5dp"
                    android:src="@drawable/bg_battle_card_back" />

                <ImageView
                    android:id="@+id/opponent_slot_two"
                    android:layout_width="48dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="@dimen/space_xs"
                    android:contentDescription="@string/battle_rival_hidden_card"
                    android:padding="5dp"
                    android:src="@drawable/bg_battle_card_back" />

                <ImageView
                    android:id="@+id/opponent_slot_three"
                    android:layout_width="48dp"
                    android:layout_height="68dp"
                    android:layout_marginHorizontal="@dimen/space_xs"
                    android:contentDescription="@string/battle_rival_hidden_card"
                    android:padding="5dp"
                    android:src="@drawable/bg_battle_card_back" />
            </LinearLayout>

            <TextView
                android:id="@+id/duel_score_text"
                style="@style/TextAppearance.Marvel.TitleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_xs"
                tools:text="Você 0 × 0 Arquivo" />

            <TextView
                style="@style/TextAppearance.Marvel.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/battle_active_zone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="2">

                <include
                    android:id="@+id/player_duel_card"
                    layout="@layout/item_duel_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/opponent_duel_card"
                    layout="@layout/item_duel_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/duel_result_banner"
                style="@style/TextAppearance.Marvel.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_duel_slot"
                android:gravity="center"
                android:minHeight="52dp"
                android:padding="@dimen/space_sm"
                tools:text="Mesa pronta. Escolha uma carta e um atributo." />

            <TextView
                style="@style/TextAppearance.Marvel.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/battle_compare_attribute" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/duel_attribute_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/attribute_powers_chip"
                    style="@style/Widget.Marvel.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/duel_powers"
                    app:chipIcon="@drawable/ic_bolt" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/attribute_experience_chip"
                    style="@style/Widget.Marvel.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/duel_experience"
                    app:chipIcon="@drawable/ic_calendar" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/attribute_appearances_chip"
                    style="@style/Widget.Marvel.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/duel_appearances"
                    app:chipIcon="@drawable/ic_comic" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/attribute_impact_chip"
                    style="@style/Widget.Marvel.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/duel_impact"
                    app:chipIcon="@drawable/ic_shield" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/start_duel_button"
                style="@style/Widget.Marvel.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/duel_start"
                app:icon="@drawable/ic_bolt" />

            <TextView
                style="@style/TextAppearance.Marvel.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/battle_hand_zone" />

            <TextView
                style="@style/TextAppearance.Marvel.BodySecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battle_hand_hint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="horizontal"
                android:weightSum="3">

                <include
                    android:id="@+id/hand_card_one"
                    layout="@layout/item_battle_hand_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xxs"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/hand_card_two"
                    layout="@layout/item_battle_hand_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_xxs"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/hand_card_three"
                    layout="@layout/item_battle_hand_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xxs"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.Marvel.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:text="@string/card_game_disclosure" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Marvel.Card.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginBottom="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Marvel.TitleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pack_title" />

                        <TextView
                            android:id="@+id/pack_status_text"
                            style="@style/TextAppearance.Marvel.BodySecondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pack_ready" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/open_pack_button"
                        style="@style/Widget.Marvel.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pack_open"
                        app:icon="@drawable/ic_cards" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pack_results"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/pack_result_one"
                        style="@style/TextAppearance.Marvel.Label"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="@dimen/space_xxs"
                        android:layout_weight="1"
                        android:background="@drawable/bg_duel_slot"
                        android:gravity="center"
                        android:padding="@dimen/space_xxs"
                        tools:text="RARA&#10;Spider-Man" />

                    <TextView
                        android:id="@+id/pack_result_two"
                        style="@style/TextAppearance.Marvel.Label"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginHorizontal="@dimen/space_xxs"
                        android:layout_weight="1"
                        android:background="@drawable/bg_duel_slot"
                        android:gravity="center"
                        android:padding="@dimen/space_xxs"
                        tools:text="ÉPICA&#10;Storm" />

                    <TextView
                        android:id="@+id/pack_result_three"
                        style="@style/TextAppearance.Marvel.Label"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="@dimen/space_xxs"
                        android:layout_weight="1"
                        android:background="@drawable/bg_duel_slot"
                        android:gravity="center"
                        android:padding="@dimen/space_xxs"
                        tools:text="LENDÁRIA&#10;Thor" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.example.marvel_app.ui.widget.PackOpeningView
        android:id="@+id/pack_opening_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>

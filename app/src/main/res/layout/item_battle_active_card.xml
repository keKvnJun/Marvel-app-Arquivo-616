<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Marvel.Card.Outlined"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    app:cardCornerRadius="@dimen/radius_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_xs">

        <ImageView
            android:id="@+id/duel_card_image"
            android:layout_width="78dp"
            android:layout_height="match_parent"
            android:background="@color/surface_secondary"
            android:contentDescription="@string/loading_image"
            android:scaleType="centerCrop"
            tools:src="@drawable/comic_collage_halftone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/duel_card_label"
                style="@style/TextAppearance.Marvel.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="SUA CARTA" />

            <TextView
                android:id="@+id/duel_card_name"
                style="@style/TextAppearance.Marvel.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Spider-Man" />

            <TextView
                android:id="@+id/duel_card_rarity"
                style="@style/TextAppearance.Marvel.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/marvel_red"
                tools:text="RARA" />

            <TextView
                android:id="@+id/duel_card_attribute_label"
                style="@style/TextAppearance.Marvel.BodySecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Versatilidade" />
        </LinearLayout>

        <TextView
            android:id="@+id/duel_card_value"
            style="@style/TextAppearance.Marvel.Headline"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/marvel_red"
            android:visibility="invisible"
            tools:text="86"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

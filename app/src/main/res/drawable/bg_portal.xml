            <gradient android:type="radial" android:gradientRadius="118dp" android:startColor="@color/jarvis_blue" android:centerColor="@color/marvel_red" android:endColor="@color/transparent" />
        </shape>
    </item>
    <item android:left="18dp" android:top="18dp" android:right="18dp" android:bottom="18dp">
        <shape android:shape="oval">
            <solid android:color="@color/app_background" />
            <stroke android:width="3dp" android:color="@color/comic_yellow" />
        </shape>
    </item>
</layer-list>

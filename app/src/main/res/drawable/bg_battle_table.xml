<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/battle_rival_zone"
                android:centerColor="@color/battle_sky"
                android:endColor="@color/battle_agent_zone" />
            <stroke android:width="2dp" android:color="@color/battle_ink" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/transparent" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/marvel_red" />
            <corners android:radius="@dimen/radius_small" />
            <stroke android:width="2dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_primary" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="@color/text_primary" />
        </shape>
    </item>
</layer-list>
